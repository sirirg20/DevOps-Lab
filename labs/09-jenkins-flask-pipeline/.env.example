# Copy to .env (git-ignored). deploy.sh creates .env with a random password if missing.
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=change-me
# JENKINS_PORT=8080

# Where the pipeline job reads the repository and Jenkinsfile from.
# Default is your local repository, mounted read-only into the container.
# After you push it yourself, you can use the GitHub URL instead:
# REPO_URL=https://github.com/<your-account>/devops.git
# REPO_URL=file:///repo-src
# BRANCH=*/main
# SCRIPT_PATH=labs/09-jenkins-flask-pipeline/Jenkinsfile
# POLL_SCM_SPEC=H/5 * * * *    # optional: poll for new commits
