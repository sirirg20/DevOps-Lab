# Copy to .env (git-ignored). deploy.sh creates .env with a random password if missing.
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=change-me
# JENKINS_PORT=8080

# Where the job checks out from. Default is the local sample repo.
# After you publish the sample code yourself, point at it, for example:
# REPO_URL=https://github.com/<your-account>/devops-sample-code.git
# REPO_URL=file:///sample-repo
# BRANCH=*/main
# POLL_SCM_SPEC=H/2 * * * *    # optional: poll for new commits every ~2 minutes
