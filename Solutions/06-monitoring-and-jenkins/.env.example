# Copy to .env (git-ignored). deploy.sh generates a random Grafana password if
# .env is missing. In Jenkins the password comes from a credential instead.
GRAFANA_ADMIN_PASSWORD=change-me

# Optional load knobs for the simulator (defaults keep alerts quiet):
# ARRIVAL_MAX=8      # builds a backlog -> HighPendingDeliveries
# DURATION_MAX=80    # slow deliveries  -> HighAverageDeliveryTime
